# Session cookies as "k=v; k=v" (must include auth_token and ct0).
# Easiest: run `python3 python/consolidate_session.py` and point here:
# X_SESSION_COOKIE=$(cat python/session_cookies.txt)
X_SESSION_COOKIE=

# Optional: load cookies from AWS Secrets Manager instead of env.
# X_SESSION_SECRET_ARN=arn:aws:secretsmanager:...
# AWS_REGION=eu-west-1

# Override Following query id if it 404s (capture from a fresh HAR).
# X_QID_FOLLOWING=UCFedrkjMz7PeEAWCWhqFw

# Enable debug logs from the TS client.
# DEBUG=1
